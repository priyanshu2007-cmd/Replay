# ==============================================================================
# Replay — Environment Variables
# Safe placeholders only. Never commit real keys.
# ==============================================================================

# NVIDIA Build hosted inference (OpenAI-compatible) — https://build.nvidia.com
# NOT OpenRouter, NOT Nebius. Keys from https://build.nvidia.com/settings/api-keys
NVIDIA_API_KEY=your_nvidia_build_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Optional per-role designated keys (override NVIDIA_API_KEY for that role)
NVIDIA_API_KEY_WATCHER=your_key_here
NVIDIA_API_KEY_VERIFIER=your_key_here
NVIDIA_API_KEY_LOCATOR=your_key_here
NVIDIA_API_KEY_REPRODUCER=your_key_here
NVIDIA_API_KEY_FIXER=your_key_here
NVIDIA_API_KEY_REPORTER=your_key_here

# Model roles (defaults in packages/agents/src/llm.ts; native NVIDIA IDs, no :free suffix)
MODEL_WATCHER=nvidia/nemotron-3.5-super-vl-120b-a12b
MODEL_VERIFIER=nvidia/nemotron-3.5-super-vl-120b-a12b
MODEL_LOCATOR=nvidia/nemotron-3.5-lightning-30b-a3b
MODEL_REPRODUCER=nvidia/nemotron-3-ultra-550b-a55b
MODEL_FIXER=nvidia/nemotron-3-ultra-550b-a55b
MODEL_REPORTER=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning

# Supabase (Database & Object Storage)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
DATABASE_URL=postgresql://postgres:your_password@db.your-project-id.supabase.co:5432/postgres
STORAGE_BUCKET_ARTIFACTS=replay-artifacts

# Local Docker Sandbox execution (optional custom socket if using Colima or remote daemon)
# DOCKER_HOST=unix:///Users/username/.colima/default/docker.sock

# Service Ports & URLs
PORT=3001
API_BASE_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
