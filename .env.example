# ==============================================================================
# Replay — Environment Variables
# Safe placeholders only. Never commit real keys.
# ==============================================================================

# Nebius Token Factory (required by the hackathon rules; OpenAI-compatible)
# Key from https://console.tokenfactory.nebius.com (API keys)
NEBIUS_API_KEY=your_nebius_token_factory_api_key_here
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# Optional per-role key overrides
NEBIUS_API_KEY_WATCHER=your_key_here
NEBIUS_API_KEY_VERIFIER=your_key_here
NEBIUS_API_KEY_LOCATOR=your_key_here
NEBIUS_API_KEY_REPRODUCER=your_key_here
NEBIUS_API_KEY_FIXER=your_key_here
NEBIUS_API_KEY_REPORTER=your_key_here

# Model roles (defaults in packages/agents/src/llm.ts; verify with pnpm smoke:models)
MODEL_WATCHER=nvidia/Nemotron-3.5-Super-VL
MODEL_VERIFIER=nvidia/Nemotron-3.5-Super-VL
MODEL_LOCATOR=nvidia/Nemotron-3_5-Lightning
MODEL_REPRODUCER=nvidia/Nemotron-3-Ultra-550b-a55b
MODEL_FIXER=nvidia/Nemotron-3-Ultra-550b-a55b
MODEL_REPORTER=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B

# Database & storage (omit DATABASE_URL to use the in-memory repository)
DATABASE_URL=postgresql://postgres:your_password@db.your-project.supabase.co:5432/postgres
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
STORAGE_BUCKET_ARTIFACTS=replay-artifacts

# Service
PORT=3001
ALLOWED_ORIGINS=http://localhost:3000
# Trusted reverse proxy configuration (set TRUST_PROXY=1 behind Caddy/nginx)
# TRUST_PROXY=1
# TRUSTED_PROXY_IPS=127.0.0.1,::1
# Vercel services deployment: writable dir for uploads/artifacts (repo is read-only)
# REPLAY_DATA_DIR=/tmp
# Empty NEXT_PUBLIC_API_URL = replay mode (no live runs)
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Sandbox execution (default: Docker in production, host copy in local dev)
# REPLAY_SANDBOX_MODE=docker
# REPLAY_SANDBOX_DOCKER_IMAGE=mcr.microsoft.com/playwright:v1.50.1-noble
# Local dev escape hatch: allow host-execution sandbox when Docker is down (never on serverless)
# REPLAY_ALLOW_HOST_SANDBOX=1
