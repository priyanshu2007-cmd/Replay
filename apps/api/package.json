{
  "name": "@replay/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "node -e \"const fs=require('node:fs');if(!fs.existsSync('../../packages/shared/dist/index.d.ts')||!fs.existsSync('../../packages/db/dist/index.d.ts')||!fs.existsSync('../../packages/agents/dist/index.d.ts')){require('node:child_process').execSync('pnpm --filter \\\"@replay/api^...\\\" build',{stdio:'inherit'})}\"",
    "build": "mkdir -p api-dist && tsc && npx esbuild src/server.ts --bundle --platform=node --format=cjs --define:import.meta=undefined --outfile=api-dist/server.cjs && npx esbuild src/worker.ts --bundle --platform=node --format=cjs --define:import.meta=undefined --outfile=api-dist/worker.cjs && npx esbuild ../../packages/db/src/migrate.ts --bundle --platform=node --format=cjs --define:import.meta=undefined --outfile=api-dist/migrate.cjs && printf '{\"type\":\"commonjs\",\"main\":\"server.cjs\"}' > api-dist/package.json",
    "typecheck": "tsc --noEmit",
    "dev": "tsx watch src/server.ts",
    "worker": "tsx watch src/worker.ts",
    "start": "node dist/server.js",
    "test": "node --test-concurrency=1 --test-reporter=spec --import tsx --test src/server.test.ts src/worker.test.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.8",
    "@replay/agents": "workspace:*",
    "@replay/db": "workspace:*",
    "@replay/sandbox": "workspace:*",
    "@replay/shared": "workspace:*",
    "@replay/storage": "workspace:*",
    "@replay/video": "workspace:*",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.7.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "esbuild": "^0.25.12",
    "typescript": "^5.7.3"
  },
  "main": "./dist/server.js",
  "types": "./dist/server.d.ts",
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "default": "./dist/server.js"
    }
  }
}
